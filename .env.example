# Copy to .env and replace this value with a long random secret.
COMOTE_LOCAL_API_TOKEN=replace-with-a-long-random-secret

# Keep this aligned with the Codex CLI version installed in the image.
CODEX_VERSION=0.146.0

# Docker Hub is slow or unreachable on some networks. These defaults use pinned
# DaoCloud proxy digests; override them with official images if desired.
NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
